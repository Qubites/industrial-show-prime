# L. S. Stålmontage – statisk side + kontakt.php (kontaktformularen sender mail til firmaet)
DirectoryIndex index.html
Options -Indexes
Options +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Den gamle sides adresser sendes til det tilsvarende afsnit på den nye side
  RewriteRule ^da/content/om-os/?$        /#about      [R=301,NE,L]
  RewriteRule ^da/node/3/?$               /#about      [R=301,NE,L]
  RewriteRule ^en/content/about-us/?$     /#about      [R=301,NE,L]
  RewriteRule ^da/content/kompetencer/?$  /#services   [R=301,NE,L]
  RewriteRule ^da/content/kunder/?$       /#references [R=301,NE,L]

  # Alt andet, der ikke findes, går til forsiden i stedet for en fejlside
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
